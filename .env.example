# ==============================================================================
# Alla Krishna Sai Reddy — Portfolio Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# Prefix: NEXT_PUBLIC_ ensures client-side availability in Next.js
# ==============================================================================

# Social & Profile Links
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username
NEXT_PUBLIC_HUGGINGFACE_URL=https://huggingface.co/your-username

# Resume / Spec Sheet Download (path to public file or external Google Drive / Dropbox link)
NEXT_PUBLIC_RESUME_URL=/resume.pdf

# Project 01: Klerk AI
NEXT_PUBLIC_KLERK_LIVE_URL=https://klerk-ai.example.com
NEXT_PUBLIC_KLERK_GITHUB_URL=https://github.com/your-username/klerk-ai

# Project 02: JobJutsu AI
NEXT_PUBLIC_JOBJUTSU_LIVE_URL=https://huggingface.co/spaces/your-username/jobjutsu-ai
NEXT_PUBLIC_JOBJUTSU_GITHUB_URL=https://github.com/your-username/jobjutsu-ai

# Project 03: Diabetic Retinopathy Classifier
NEXT_PUBLIC_RETINOPATHY_LIVE_URL=https://diabetic-retinopathy.example.com
NEXT_PUBLIC_RETINOPATHY_GITHUB_URL=https://github.com/your-username/diabetic-retinopathy
NEXT_PUBLIC_RETINOPATHY_PUBLICATION_URL=https://www.irjet.net
